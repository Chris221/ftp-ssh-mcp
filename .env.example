# Shared defaults. Any profile inherits these unless it sets its own value.
REMOTE_HOST=
REMOTE_USER=
# Inherited ONLY by profiles that do not set their own *_USER. A profile naming
# its own user is a distinct identity, so its secret must be set explicitly.
REMOTE_PASSWORD=
# Remote paths are confined to this directory. A profile with no base directory
# of any kind is NOT confined, so set at least one: each profile falls back to
# the other's when it has none of its own.
REMOTE_BASE_DIR=

# FTP / FTPS profile
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BASE_DIR=
FTP_SECURITY=ftps
FTP_TLS_REJECT_UNAUTHORIZED=true
FTP_TIMEOUT_MS=30000

# SSH profile (also provides the sftp transport)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PASSPHRASE=
# SHA-256 host key fingerprint to pin. Without it any host key is accepted, so
# a machine on the network path can impersonate the host and collect the
# password. Get the value with:
#   ssh-keyscan -t rsa <host> | ssh-keygen -lf -
# and paste the SHA256:... field (a bare hex digest is accepted too).
SSH_HOST_FINGERPRINT=
SSH_BASE_DIR=
SSH_ACTIVATE=
SSH_TIMEOUT_MS=120000
SSH_MAX_OUTPUT=100000
SSH_ALLOWED_CMDS=npm,node,mysql,mysqldump,touch,ls,cat,tail,head,df,du,pwd

# Database, reached through the SSH profile
DB_USER=
DB_PASSWORD=
DB_NAME=

# Selection and safety. All default to off.
FILE_TRANSPORT=
MCP_CAPABILITIES=
FTP_READONLY=false
FTP_ALLOW_DELETE=false
SSH_ALLOW_EXEC=false
